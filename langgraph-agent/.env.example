# --- LLM (required in both modes) ---
ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-5

# --- Mode A: offline (no Jira account needed) ---
# Read the ticket from a local file (path relative to the repo root):
# TICKET_FILE=tickets/WSP-101.md

# --- Mode B: real Jira MCP (default: uvx mcp-atlassian, needs Python's uv) ---
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@your-org.com
JIRA_API_TOKEN=...

# --- Or point at any other Jira MCP server instead ---
# JIRA_MCP_COMMAND=npx
# JIRA_MCP_ARGS=-y @your/jira-mcp-server

# --- App under test (default matches playwright.config.ts) ---
# APP_BASE_URL=https://playwright-workshop.pages.dev
