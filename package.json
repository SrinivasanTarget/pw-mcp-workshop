{
  "name": "pw-mcp-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + MCP + Test Agents workshop - staged branches, OpenCode and Claude Code",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://playwright-workshop.pages.dev/login",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "cli": "playwright cli"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "ISC"
}
